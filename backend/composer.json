{
    "name": "supplyflow/api",
    "description": "SupplyFlow local development API foundation, based on CodeIgniter appstarter 4.7.5",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-mysqli": "*",
        "codeigniter4/framework": "4.7.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.4.26"
        },
        "allow-plugins": false
    }
}
